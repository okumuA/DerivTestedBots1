<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
  <variables>
    <variable type="" id="loss_threshold">stop loss</variable>
    <variable type="" id="max_daily_loss">max daily loss</variable>
    <variable type="" id="profit_target">profit</variable>
    <variable type="" id="initial_trade_size">initial amount</variable>
    <variable type="" id="martingale_multiplier">martingale</variable>
    <variable type="" id="dynamic_lot_size">dynamic lot size</variable>
    <variable type="" id="current_equity">current equity</variable>
  </variables>
  <block type="trade_definition" id="main_trade_block" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_setup">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="trade_type">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">callput</field>
            <next>
              <block type="trade_definition_contracttype" id="contract_type">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candle_interval">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartonerror" id="error_handling">
                        <field name="RESTARTONERROR">TRUE</field>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="initialize_stop_loss">
        <field name="VAR" id="loss_threshold">stop loss</field>
        <value name="VALUE">
          <block type="math_number" id="stop_loss_value">
            <field name="NUM">50</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="initialize_profit_target">
            <field name="VAR" id="profit_target">profit</field>
            <value name="VALUE">
              <block type="math_number" id="profit_target_value">
                <field name="NUM">100</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="initialize_initial_trade_size">
                <field name="VAR" id="initial_trade_size">initial amount</field>
                <value name="VALUE">
                  <block type="math_number" id="initial_trade_size_value">
                    <field name="NUM">5</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="initialize_max_daily_loss">
                    <field name="VAR" id="max_daily_loss">max daily loss</field>
                    <value name="VALUE">
                      <block type="math_number" id="max_daily_loss_value">
                        <field name="NUM">200</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="initialize_martingale_multiplier">
                        <field name="VAR" id="martingale_multiplier">martingale</field>
                        <value name="VALUE">
                          <block type="math_number" id="martingale_multiplier_value">
                            <field name="NUM">1.05</field>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="AFTER_PURCHASE">
      <block type="controls_if" id="check_result">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="check_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="update_trade_size_on_win">
            <field name="VAR" id="initial_trade_size">initial amount</field>
            <value name="VALUE">
              <block type="variables_get" id="win_amount">
                <field name="VAR" id="initial_trade_size">initial amount</field>
              </block>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="math_change" id="adjust_trade_size_on_loss">
            <field name="VAR" id="initial_trade_size">initial amount</field>
            <value name="DELTA">
              <block type="math_arithmetic" id="calculate_new_trade_size">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <block type="variables_get" id="current_trade_size">
                    <field name="VAR" id="initial_trade_size">initial amount</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="martingale_multiplier_value">
                    <field name="VAR" id="martingale_multiplier">martingale</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
